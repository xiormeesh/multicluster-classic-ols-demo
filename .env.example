# Environment config for multicluster classic OLS demo.
# Copy to .env and edit for your environment:  cp .env.example .env
#
# Default values are for shiftlet-provisioned SNO clusters.

# Hub cluster
HUB_HOSTNAME="api.hub.shiftlet.local"
HUB_IP="192.168.1.80"
HUB_KUBECONFIG="/var/lib/shiftlet/hub/kubeconfig"

# Spoke cluster
SPOKE_HOSTNAME="api.spoke.shiftlet.local"
SPOKE_IP="192.168.1.82"
SPOKE_KUBECONFIG="$HOME/spoke-kubeconfig"
